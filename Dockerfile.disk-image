# Dockerfile.disk-image — packs a rootfs (named build context "rootfs") into a
# bootable GPT disk image. Runs entirely in userspace via image-packer, so no
# privileged RUN steps or loop devices are needed.

ARG GRUB_MODULES="part_gpt fat ext2 normal configfile search search_fs_uuid linux echo reboot gzio all_video font gfxterm"

# Each GRUB EFI binary is built in a stage pinned to its native platform so
# that the grub-efi-*-bin package is always available without foreign-arch
# tricks. BuildKit emulates the non-native stage via QEMU when needed.
FROM --platform=linux/amd64 debian:bookworm-slim AS grub-x64-builder
ARG GRUB_MODULES
RUN apt-get update \
 && apt-get install -y --no-install-recommends grub2-common grub-efi-amd64-bin \
 && apt-get clean && rm -rf /var/lib/apt/lists/*
RUN grub-mkimage -O x86_64-efi -o /bootx64.efi -p /boot/grub \
      -d /usr/lib/grub/x86_64-efi ${GRUB_MODULES}

FROM --platform=linux/arm64 debian:bookworm-slim AS grub-aa64-builder
ARG GRUB_MODULES
RUN apt-get update \
 && apt-get install -y --no-install-recommends grub2-common grub-efi-arm64-bin \
 && apt-get clean && rm -rf /var/lib/apt/lists/*
RUN grub-mkimage -O arm64-efi -o /bootaa64.efi -p /boot/grub \
      -d /usr/lib/grub/arm64-efi ${GRUB_MODULES}

# image-packer embeds both EFI binaries and runs on the build host, so it is
# compiled for BUILDPLATFORM regardless of the target architecture.
FROM --platform=${BUILDPLATFORM} golang:1.25-bookworm AS image-packer-builder
WORKDIR /src/image-packer
COPY image-packer/go.mod image-packer/go.sum ./
RUN go mod download
COPY image-packer/ ./
COPY --from=grub-x64-builder  /bootx64.efi  efi/bootx64.efi
COPY --from=grub-aa64-builder /bootaa64.efi efi/bootaa64.efi
RUN CGO_ENABLED=0 go build -o /image-packer .

FROM --platform=${BUILDPLATFORM} debian:bookworm-slim AS packager
# The "rootfs" context is built for the target platform; BuildKit picks the
# matching variant automatically even though this stage runs on BUILDPLATFORM.
COPY --from=rootfs / /rootfs/
COPY --from=image-packer-builder /image-packer /image-packer
ARG TARGETARCH
ARG EFI_SIZE=512M
ARG DISTRO=linux
RUN /image-packer

FROM scratch
COPY --from=packager /output/ ./
